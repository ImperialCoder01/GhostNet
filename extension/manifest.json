{
  "manifest_version": 3,
  "name": "GhostNet AI — Phishing & Scam Shield",
  "version": "1.0.0",
  "description": "Real-time AI-powered phishing, URL typosquatting, and social engineering detector.",
  "permissions": [
    "webNavigation",
    "tabs",
    "storage",
    "scripting",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GhostNet AI Threat Scanner"
  },
  "web_accessible_resources": [
    {
      "resources": ["warning.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
