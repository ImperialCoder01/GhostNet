# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# Supabase (required)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Required for Feature 3 feed sync & Feature 4 community threat feed writes)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Engine - Server-side keys for api/analyze.js
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key

# AI Timeout in milliseconds (Feature 2 — default 4000ms)
AI_TIMEOUT_MS=4000

# Vercel Cron Secret (Feature 3 — for /api/cron/sync-feeds authorization)
# CRON_SECRET=your_random_cron_secret_token

# Voice & Deepfake Scanner (Feature 6 — flag-gated, default false)
ENABLE_VOICE_SCANNER=false
VITE_ENABLE_VOICE_SCANNER=false

# Pre-Click Interceptor (Feature 8 — flag-gated, default false)
ENABLE_PRE_CLICK_INTERCEPTOR=false

# Browser Extension API Base URL (Feature 7)
# EXTENSION_API_BASE_URL=https://ghost-net-zeta.vercel.app

# Optional: Public base URL for Android/native builds
# VITE_API_BASE_URL=https://your-project.vercel.app
